{
     "name": "innora-hotel-backend",
     "version": "1.0.0",
     "description": "Enterprise-grade INNORA Hotel Management System Backend with NestJS & Prisma",
     "license": "MIT",
     "scripts": {
          "build": "prisma generate && nest build",
          "format": "prettier --write \"src/**/*.ts\"",
          "start": "nest start",
          "start:dev": "nest start --watch",
          "start:debug": "nest start --debug --watch",
          "start:prod": "node dist/src/main",
          "start:deploy": "prisma migrate deploy && node dist/src/main",
          "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
          "prisma:generate": "prisma generate",
          "prisma:migrate": "prisma migrate dev",
          "prisma:deploy": "prisma migrate deploy",
          "prisma:studio": "prisma studio",
          "seed:data": "ts-node prisma/seed-data.ts",
          "prisma:seed": "ts-node prisma/seed-data.ts"
     },
     "dependencies": {
          "@nestjs/common": "^10.3.10",
          "@nestjs/config": "^3.2.3",
          "@nestjs/core": "^10.3.10",
          "@nestjs/jwt": "^10.2.0",
          "@nestjs/passport": "^10.0.3",
          "@nestjs/platform-express": "^10.3.10",
          "@nestjs/swagger": "^7.4.0",
          "@nestjs/throttler": "^5.2.0",
          "@prisma/adapter-pg": "^7.8.0",
          "@prisma/client": "^7.8.0",
          "bcryptjs": "^2.4.3",
          "class-transformer": "^0.5.1",
          "class-validator": "^0.14.1",
          "cloudinary": "^2.3.0",
          "cookie-parser": "^1.4.7",
          "dotenv": "^17.4.2",
          "helmet": "^7.1.0",
          "jsonwebtoken": "^9.0.3",
          "multer": "^1.4.5-lts.1",
          "passport": "^0.7.0",
          "passport-jwt": "^4.0.1",
          "pg": "^8.21.0",
          "reflect-metadata": "^0.2.2",
          "rxjs": "^7.8.1",
          "uuid": "^9.0.1"
     },
     "devDependencies": {
          "@nestjs/cli": "^10.4.2",
          "@nestjs/schematics": "^10.1.2",
          "@types/bcryptjs": "^2.4.6",
          "@types/cookie-parser": "^1.4.7",
          "@types/express": "^4.17.21",
          "@types/jsonwebtoken": "^9.0.10",
          "@types/multer": "^1.4.11",
          "@types/node": "^20.14.10",
          "@types/passport-jwt": "^4.0.1",
          "@types/pg": "^8.20.0",
          "@types/uuid": "^9.0.8",
          "prisma": "^7.8.0",
          "source-map-support": "^0.5.21",
          "ts-loader": "^9.5.1",
          "ts-node": "^10.9.2",
          "tsconfig-paths": "^4.2.0",
          "typescript": "^5.5.3"
     }
}
